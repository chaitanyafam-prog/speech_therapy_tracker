# Copy this file to ".env" (same folder) and put your real values in the copy.
# ".env" is private: never paste its contents into chat, email or a public repository.

# Public link from the screener to the clinician directory.
THERAPY_TRACKER_URL=

# Admin password for adding, reviewing, and publishing directory entries.
# Choose a unique password before enabling admin access.
ADMIN_PASSWORD=

# Required to register doctors outside of the local pilot default.
DOCTOR_SIGNUP_CODE=replace-with-a-private-code

# Optional server-side Google Places API key for live clinician searches.
GOOGLE_MAPS_API_KEY=

# Optional session key. If unset, a persistent local key is generated in instance/.
SECRET_KEY=
